{
  "name": "next-tanstack-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "turbo run dev --parallel --filter=web --filter=admin",
    "dev:web": "turbo run dev --filter=web",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:admin": "turbo run build --filter=admin",
    "start:web": "pnpm --filter web start",
    "start:admin": "pnpm --filter admin start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "codegen": "pnpm --filter @repo/api-client codegen",
    "codegen:main": "pnpm --filter @repo/api-client codegen:main",
    "storybook": "pnpm --filter @repo/ui storybook",
    "build-storybook": "pnpm --filter @repo/ui build-storybook"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.8.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.1",
      "react-dom": "19.2.1"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
