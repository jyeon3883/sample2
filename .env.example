# ──────────────────────────────────────────────────────────────
# .env.example — 전체 변수 계약 문서
#
# 사용하는 env 파일 (이 3가지만 사용):
#   .env.dev    — 개발 환경 기본값 (커밋 가능)
#   .env.prod   — 운영 환경 기본값 (커밋 가능)
#   .env.local  — 로컬 개인 오버라이드 (gitignore, 커밋 금지)
#
# 로드 우선순위 (낮음 → 높음):
#   루트 .env.dev|.prod → 앱 .env.dev|.prod → 루트 .env.local → 앱 .env.local
#
# dev 서버(next dev): .env.dev + .env.local
# 운영 빌드(next build): .env.prod + .env.local
# ──────────────────────────────────────────────────────────────

# ── 루트 .env.dev / .env.prod ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
ORVAL_OPENAPI_URL_MAIN=http://localhost:8080/v3/api-docs

# ── apps/web/.env.dev / .env.prod ────────────────────────────
# NEXT_PUBLIC_APP_NAME=Web App

# ── apps/admin/.env.dev / .env.prod ──────────────────────────
# NEXT_PUBLIC_APP_NAME=Admin App
# NEXT_PUBLIC_ADMIN_DASHBOARD_TITLE=Admin Dashboard

# ── .env.local 예시 (개인 PC 전용, 필요 시만 작성) ───────────
# NEXT_PUBLIC_API_URL=http://192.168.0.10:8080
